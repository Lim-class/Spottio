                <button type="button" @click="$emit('toggle-view-once')" :class="['px-3 py-1.5 text-xs font-bold rounded-xl border transition', isViewOnceAudio ? 'bg-amber-500 text-white border-amber-600 shadow' : 'bg-white text-gray-700 border-gray-300']" title="Il vocale verrà eliminato al primo ascolto">
