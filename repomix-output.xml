    <div id="vue-user-app" v-cloak class="flex-grow p-4 md:p-8 flex flex-col items-center pt-10 overflow-y-auto w-full relative">
        
        <div class="bg-white p-6 rounded-3xl shadow-sm w-full max-w-md mb-10">
            <div class="flex items-center gap-4 mb-8">
                <div :class="avatarClasses.wrapper" @click="handleAvatarClick">
                    <div v-html="getUserAvatarHtml(userAvatarUrl, userData.username, avatarClasses.img)"></div>
                </div>
                
                <div class="text-left flex-grow min-w-0">
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex items-center gap-1.5 min-w-0">
                            <h2 class="text-2xl font-bold text-gray-800 truncate flex items-center">
                                {{ userData.username || translateText('loadingPosts', 'Caricamento...') }}
                                <span v-if="userData.isVerified" v-html="verifiedBadgeIcon"></span>
                            </h2>
                        </div>
                        
                        <button 
                            v-if="showFollowBtn" 
                            @click="toggleFollow" 
                            :disabled="isFollowLoading"
                            :class="followBtnClass">
                            {{ followBtnText }}
