                    <div class="flex items-center gap-2 mt-1">
                        <p class="text-gray-500 text-sm break-words">{{ userData.bio || translateText('noBio', 'Nessuna bio impostata') }}</p>
                    </div>
                </div>
            </div>

            <!-- Contatori Statistiche -->
            <profile-stats-bar
                :posts-count="postsCount"
