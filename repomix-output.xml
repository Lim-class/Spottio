                        <button type="submit" :disabled="modals.ban.isSubmitting" class="w-1/2 py-2.5 px-4 bg-blue-600 text-white text-sm font-semibold rounded-xl hover:bg-blue-700 transition disabled:opacity-50">
                            {{ modals.ban.isSubmitting ? 'Invio...' : 'Invia Ricorso' }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <footer class="mt-8 mb-4 w-full">
        <div class="flex flex-wrap justify-center space-x-4">
            <a href="footer/info.html?section=storia" class="bg-white text-gray-800 py-2 px-4 rounded-full shadow-md hover:bg-gray-200 transition duration-300 ease-in-out mb-2 sm:mb-0">Storia</a>
            <a href="footer/info.html?section=policy" class="bg-white text-gray-800 py-2 px-4 rounded-full shadow-md hover:bg-gray-200 transition duration-300 ease-in-out mb-2 sm:mb-0">Policy</a>
            <a href="footer/info.html?section=privacy" class="bg-white text-gray-800 py-2 px-4 rounded-full shadow-md hover:bg-gray-200 transition duration-300 ease-in-out mb-2 sm:mb-0">Privacy</a>
