                                    <span class="absolute right-0 -top-4 text-[9px] font-bold text-gray-400 bg-white px-1">
                                        {{ formatDuration(weeklyStats.dailyAverage) }}
                                    </span>
                                </div>

                                <div class="flex items-end justify-between gap-2 sm:gap-4 h-36 relative z-10 px-1">
