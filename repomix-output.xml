// Funzione per caricare l'immagine del profilo nella navbar
async function loadNavProfileImage() {
    const navImg = document.getElementById('nav-profile-img');
    if (!navImg) return;

    const auth = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
    const db = window.db || (typeof firebase !== 'undefined' ? firebase.firestore() : null);

    if (auth && db) {
        auth.onAuthStateChanged(async (user) => {
            if (user) {
                try {
                    const userDoc = await db.collection("users").doc(user.uid).get();
                    if (userDoc.exists) {
                        const data = userDoc.data();
                        const avatarUrl = data.userPfUri || data.profileImage;
                        if (avatarUrl) {
                            navImg.src = avatarUrl;
                        }
                    }
                } catch (error) {
                    console.error("Errore nel caricamento dell'immagine profilo nella navbar:", error);
                }
            }
        });
    }
}

// --- PROTEZIONE REAL-TIME UTENTI BANNATI ---
(function initRealtimeBanGuard() {
    const auth = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
    const db = window.db || (typeof firebase !== 'undefined' ? firebase.firestore() : null);

    if (!auth || !db) return;

    auth.onAuthStateChanged((user) => {
        if (!user) return;

        // Ascolto in tempo reale delle modifiche al profilo utente
        db.collection("users").doc(user.uid).onSnapshot(async (docSnapshot) => {
            if (!docSnapshot.exists) return;

            const data = docSnapshot.data();
            const banned = data.banned;
            let isBanned = false;
            let reason = "";

            if (banned && banned.status === true) {
                if (banned.bannedUntil) {
                    const now = new Date();
                    const expiry = banned.bannedUntil.toDate ? banned.bannedUntil.toDate() : new Date(banned.bannedUntil);
                    if (now < expiry) {
                        isBanned = true;
                        reason = banned.reason || "Violazione del regolamento";
                    }
                } else {
                    isBanned = true;
                    reason = banned.reason || "Violazione del regolamento";
                }
            } else if (data.isSuspended === true) {
                isBanned = true;
                reason = "Sospensione da parte dell'amministratore";
            }

            // Se l'utente risulta bannato mentre è attivo nell'app:
            if (isBanned) {
                console.warn("Account bannato durante la sessione attiva. Espulsione...");
                await auth.signOut();
                localStorage.removeItem('currentUser');
                localStorage.removeItem('isAdmin');
                localStorage.removeItem('currentUid');
                sessionStorage.clear();

                // Reindirizza a login mostrando la motivazione
                window.location.href = `../login/login.html?banned=true&reason=${encodeURIComponent(reason)}`;
            }
        }, (error) => {
            console.error("Errore listener real-time ban:", error);
        });
    });
})();
