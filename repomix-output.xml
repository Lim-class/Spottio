                                    <span class="text-gray-900">{{ formatDuration(selectedDayInfo.minutes) }}</span>
                                </div>
                            </div>

                            <div class="relative pt-6 pb-2">
                                
                                <div class="absolute left-0 right-0 border-b border-dashed border-gray-300 pointer-events-none z-0"
