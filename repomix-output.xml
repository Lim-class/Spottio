                </button>
            </div>
        </div>

        <!-- Contenuto del README Formattato -->
        <div class="mt-8 space-y-6 text-sm md:text-base leading-relaxed">

            <section>
                <h2 class="text-xl font-bold text-gray-900 mb-3 border-b pb-2">📂 Struttura Feature-Based & Componenti JS</h2>
                <pre class="bg-gray-900 text-gray-100 p-4 rounded-xl text-xs sm:text-sm overflow-x-auto font-mono">
chat/
├── chat.html                               # Wrapper principale e mount app Vue 3
├── chat.css                                # Stili custom scrollbar e responsive mobile (&lt; 1024px)
├── spottio-crypto.js                       # Motore crittografico AES e routing deterministico ID chat
├── README.md                               # Documentazione architetturale del modulo
│
├── core/
│   ├── chat-helpers.js                     # Cache globale UID, sanitizzazione XSS, date e avatar
│   └── chat-main.js                        # Controller Vue 3, bootstrap Auth e registrazione componenti
│
├── sidebar/
│   └── chat-sidebar.component.js           # Componente: Ricerca persone e lista conversazioni/gruppi
│
├── messages/
│   ├── use-chat-messages.js                # Composable: Stream Firestore, impaginazione (5 msg), vocali
│   ├── chat-messages.component.js          # Componente: Header, bolle messaggi, azioni e barra input
│   └── message-info-modal.component.js     # Componente: Modale ricevute di lettura e stato consegna
│
├── groups/
│   ├── use-chat-groups.js                  # Composable: Creazione gruppi, info, permessi admin e kick
│   ├── group-create-modal.component.js     # Componente: Modale wizard creazione nuovo gruppo
│   └── group-info-modal.component.js       # Componente: Modale dettagli gruppo, lista membri e admin panel
│
├── theme/
│   └── use-chat-theme.js                   # Composable: Gestione sfondi (ColoriSfondo / Cloudinary)
│
└── ephemeral/
    └── ephemeral-modal.component.js        # Componente: Modale timer personalizzato messaggi effimeri</pre>
            </section>

            <section>
                <h2 class="text-xl font-bold text-gray-900 mb-3 border-b pb-2">🏗️ Schema Firestore Aggiornato (NoSQL)</h2>
                <pre class="bg-gray-900 text-gray-100 p-4 rounded-xl text-xs sm:text-sm overflow-x-auto font-mono">
🔥 Firestore Root
├── 📁 users (Doc ID: uid)
│    ├── username: string
│    ├── userPfUri: string
│    ├── isVerified: boolean
│    └── chatBackgroundColor: string
│
├── 📁 ColoriSfondo (Doc ID: auto)
│    ├── hex: string
│    └── nome: string
│
├── 📁 chat_previews (Doc ID: conversationId o groupId)
│    ├── isGroup: boolean
│    ├── groupId: string [Opzionale]
│    ├── groupName: string [Opzionale]
│    ├── groupAvatarUrl: string [Opzionale]
│    ├── participants: array&lt;string&gt;
│    ├── lastMessage: string (AES)
│    ├── lastSender: string
│    └── lastUpdate: timestamp
│
├── 📁 chats (Doc ID: conversationId)
│    ├── ephemeralDuration: number [Secondi]
│    └── 📁 messages (Doc ID: auto)
│         ├── sender: string
│         ├── receiver: string
│         ├── text: string (AES)
│         ├── timestamp: timestamp
│         ├── expiresAt: timestamp [Opzionale per effimeri]
│         ├── readReceipts: map&lt;UID, timestamp&gt;
│         ├── deletedFor: array&lt;UID&gt;
│         ├── reactions: map&lt;emoji, array&lt;UID&gt;&gt;
│         ├── replyTo: map&lt;id, senderName, text&gt;
│         ├── edited: boolean
│         └── deleted: boolean
│
└── 📁 groups (Doc ID: groupId)
     ├── name: string
     ├── avatarUrl: string
     ├── createdBy: string
     ├── members: array&lt;string&gt;
     ├── memberNames: map&lt;UID, username&gt;
     ├── ephemeralDuration: number [Secondi]
     └── 📁 chats (Doc ID: auto)
          ├── text: string (AES)
          ├── sender: string
          ├── timestamp: timestamp
          ├── expiresAt: timestamp
          ├── readReceipts: map&lt;UID, timestamp&gt;
          ├── deletedFor: array&lt;UID&gt;
          ├── reactions: map&lt;emoji, array&lt;UID&gt;&gt;
          └── replyTo: map&lt;id, senderName, text&gt;</pre>
            </section>

            <section>
                <h2 class="text-xl font-bold text-gray-900 mb-3 border-b pb-2">🧩 Suddivisione dei Componenti JS</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="p-4 bg-gray-50 border border-gray-200 rounded-xl">
                        <h3 class="font-bold text-gray-800">chat-sidebar.component.js</h3>
                        <p class="text-xs text-gray-600 mt-1">Isola la ricerca full-text utenti, il bottone anonimo e l'elenco scrollabile delle conversazioni attive con badge verificato.</p>
                    </div>
                    <div class="p-4 bg-gray-50 border border-gray-200 rounded-xl">
                        <h3 class="font-bold text-gray-800">chat-messages.component.js</h3>
                        <p class="text-xs text-gray-600 mt-1">Renderizza l'area centrale, la paginazione incrementale (a blocchi di 5), messaggi multimediali, registratore vocale webm e menu contestuale.</p>
                    </div>
                    <div class="p-4 bg-gray-50 border border-gray-200 rounded-xl">
                        <h3 class="font-bold text-gray-800">group-create / group-info modals</h3>
                        <p class="text-xs text-gray-600 mt-1">Gestione separata per il modale di creazione gruppo (con preview blob immediata) e il pannello info/amministrazione partecipanti.</p>
                    </div>
                    <div class="p-4 bg-gray-50 border border-gray-200 rounded-xl">
                        <h3 class="font-bold text-gray-800">ephemeral-modal.component.js</h3>
                        <p class="text-xs text-gray-600 mt-1">Modale dedicato alla configurazione personalizzata dei messaggi effimeri con salvataggio sincronizzato sul documento di chat.</p>
                    </div>
                </div>
            </section>

        </div>
