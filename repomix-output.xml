                <button type="button" @click="$emit('cancel-audio')" class="px-3 py-1.5 text-xs font-semibold bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg">Annulla</button>
                <button type="button" @click="$emit('stop-audio')" class="px-4 py-1.5 text-xs font-bold bg-red-600 hover:bg-red-700 text-white rounded-lg shadow">Invia Vocale</button>
            </div>

            <!-- Form di Invio con Bozze Persistenti -->
            <form v-if="activeChat && activeChat.id && (!isAnon || !activeChat.isBlocked) && !isRecordingAudio" @submit.prevent="$emit('send-message')" class="flex w-full shrink-0 gap-2 sm:gap-3 items-center">
                <label :class="['p-3 bg-gray-100 text-gray-600 rounded-lg transition-colors shrink-0', (isAnon && isAnonWaitingForReply) ? 'opacity-40 cursor-not-allowed' : 'cursor-pointer hover:bg-gray-200']" title="Allega Media">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                    <input type="file" @change="$emit('send-media', $event)" :disabled="isAnon && isAnonWaitingForReply" class="hidden" accept="image/*,video/*,audio/*">
                </label>

                <button type="button" @click="$emit('start-audio')" :disabled="isAnon && isAnonWaitingForReply" :class="['p-3 bg-gray-100 text-gray-600 rounded-lg transition-colors shrink-0', (isAnon && isAnonWaitingForReply) ? 'opacity-40 cursor-not-allowed' : 'hover:bg-red-50 hover:text-red-600']" title="Registra Vocale">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z"/><path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/></svg>
                </button>

                <input type="text" 
                       id="chat-message-input" 
                       :value="newMessage" 
                       :disabled="isAnon && isAnonWaitingForReply"
                       @input="$emit('update:newMessage', $event.target.value); $emit('handle-mention', $event)" 
                       autocomplete="off" 
                       :placeholder="isAnon ? (isAnonWaitingForReply ? 'In attesa di risposta dal destinatario...' : 'Scrivi una risposta anonima... (bozza salvata)') : 'Scrivi un messaggio... (bozza salvata)'" 
                       :class="['flex-grow min-w-0 p-3 rounded-lg bg-gray-100 border border-gray-300 focus:outline-none focus:ring-2 disabled:opacity-50', isAnon ? 'focus:ring-purple-500' : 'focus:ring-blue-500']">
                
                <button type="submit" 
                        :disabled="isAnon && isAnonWaitingForReply" 
                        :class="['shrink-0 px-4 sm:px-6 py-3 text-white font-semibold rounded-lg shadow-md transition-colors', isAnon ? 'bg-purple-600' : 'bg-blue-600', (isAnon && isAnonWaitingForReply) ? 'opacity-40 cursor-not-allowed' : (isAnon ? 'hover:bg-purple-700' : 'hover:bg-blue-700')]">
                    Invia
                </button>
            </form>

            <!-- Modale Programmazione Messaggio -->
            <div v-if="showScheduleModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center z-[80] p-4">
                <div class="bg-white p-6 rounded-3xl shadow-2xl w-full max-w-sm flex flex-col border border-gray-100">
                    <div class="flex justify-between items-center border-b pb-3 mb-4">
                        <h3 class="text-base font-bold text-gray-800 flex items-center gap-2">
                            📅 {{ isAnon ? 'Programma Invio Anonimo' : 'Programma Invio Messaggio' }}
                        </h3>
                        <button @click="$emit('close-schedule-modal')" class="text-gray-400 hover:text-gray-600 text-lg font-bold">×</button>
                    </div>
                    <p class="text-xs text-gray-600 mb-3">Scegli la data e l'orario in cui il testo digitato nell'input verrà inviato automaticamente.</p>
                    <input type="datetime-local" :value="scheduledDateTime" @input="$emit('update:scheduledDateTime', $event.target.value)" class="p-2.5 bg-gray-50 border border-gray-300 rounded-xl text-xs font-semibold mb-4 w-full focus:ring-2 focus:outline-none">
                    <div class="flex justify-end gap-2">
                        <button @click="$emit('close-schedule-modal')" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-xl">Annulla</button>
                        <button @click="$emit('confirm-schedule')" :class="['px-4 py-2 text-white text-xs font-bold rounded-xl shadow', isAnon ? 'bg-purple-600 hover:bg-purple-700' : 'bg-blue-600 hover:bg-blue-700']">Programma</button>
                    </div>
                </div>
            </div>

        </div>
    `
};
