// chat/messages/chat-messages.component.js
window.ChatMessagesComponent = {
    name: 'ChatMessagesComponent',
    props: {
        mode: { type: String, default: 'standard' }, // 'standard' | 'anonymous'
        activeChat: { type: Object, default: () => ({ id: null }) },
        isChatActiveMobile: { type: Boolean, default: false },
        isReceiver: { type: Boolean, default: false },
        isAnonWaitingForReply: { type: Boolean, default: false },
        ephemeralDuration: { type: Number, default: 0 },
        getEphemeralLabel: { type: String, default: 'Effimeri: No' },
        selectedBg: { type: String, default: 'default' },
        bgOptions: { type: Array, default: () => [] },
        bgStyle: { type: Object, default: () => ({}) },
        messages: { type: Array, default: () => [] },
        hasMoreMessages: { type: Boolean, default: false },
        isLoadingMore: { type: Boolean, default: false },
        openDropdownId: { type: String, default: null },
        editingMsgId: { type: String, default: null },
        editMsgText: { type: String, default: '' },
        mentionResults: { type: Array, default: () => [] },
        replyingTo: { type: Object, default: null },
        isRecordingAudio: { type: Boolean, default: false },
        audioRecordingSeconds: { type: Number, default: 0 },
        newMessage: { type: String, default: '' },
        getCurrentUid: { type: Function, required: true },
        getAvatar: { type: Function, required: true },
        verifiedIcon: { type: Function, required: true },
        isViewOnceAudio: { type: Boolean, default: false },
        pinnedMessage: { type: Object, default: null },
        showScheduleModal: { type: Boolean, default: false },
        scheduledDateTime: { type: String, default: '' }
    },
    emits: [
        'go-back', 'group-info-click', 'block-thread', 'ephemeral-change', 'update:selectedBg',
        'change-bg', 'upload-custom-bg', 'load-older', 'scroll-messages',
        'start-reply', 'toggle-dropdown', 'view-msg-info', 'start-edit',
        'delete-for-me', 'delete-for-everyone', 'report-msg', 'scroll-to-msg', 'update:editMsgText',
        'cancel-edit', 'save-edit', 'toggle-reaction', 'insert-mention', 'cancel-reply',
        'cancel-audio', 'stop-audio', 'start-audio', 'send-media', 'send-message',
        'update:newMessage', 'handle-mention', 'toggle-view-once', 'play-view-once',
        'toggle-pin-msg', 'open-schedule-modal', 'close-schedule-modal',
        'update:scheduledDateTime', 'confirm-schedule'
    ],
    setup(props, { emit }) {
        const isEphemeralMenuOpen = Vue.ref(false);
        const isAnon = Vue.computed(() => props.mode === 'anonymous');

        const selectPresetEphemeral = (val) => {
            isEphemeralMenuOpen.value = false;
            if (val === 'custom') {
                emit('ephemeral-change', { target: { value: 'custom' } });
            } else {
                emit('ephemeral-change', { target: { value: Number(val) } });
            }
        };

        const triggerReportMessage = (msg) => {
            if (!window.SpottioReport) return;
            const targetType = isAnon.value ? 'anon_message' : 'message';
            let authorUid = msg.senderId || '';
            let authorUsername = msg.senderName || 'Utente';

            if (isAnon.value) {
                authorUid = msg.isFromAnonymous ? props.activeChat.authorUid : props.activeChat.targetUid;
                authorUsername = msg.isFromAnonymous ? (props.activeChat.displayTitle || 'Anonimo') : (props.activeChat.displayTitle || 'Utente');
            }

            const convId = isAnon.value 
                ? props.activeChat.id 
                : (props.activeChat.isGroup ? props.activeChat.id : window.Spottio.getConversationId(props.getCurrentUid(), props.activeChat.id));

            window.SpottioReport.openModal({
                targetType,
                targetId: msg.id,
                conversationId: convId,
                isGroup: !!props.activeChat.isGroup,
                authorUid,
                authorUsername,
                contentPreview: msg.rawText || '[Contenuto multimediale]'
            });
            emit('toggle-dropdown', null);
        };

        const closeAllDropdowns = () => {
            isEphemeralMenuOpen.value = false;
        };

        Vue.onMounted(() => {
            document.addEventListener('click', closeAllDropdowns);
        });

        Vue.onUnmounted(() => {
            document.removeEventListener('click', closeAllDropdowns);
        });

        return {
            isAnon,
            isEphemeralMenuOpen,
            selectPresetEphemeral,
            triggerReportMessage
        };
    },
    template: `
        <div id="chat-content-container" class="w-full lg:w-2/3 bg-white p-6 rounded-2xl lg:rounded-r-2xl lg:rounded-l-none shadow-xl flex flex-col h-[calc(100vh-4rem)] relative" :class="{'hidden-mobile': !isChatActiveMobile}">
            
            <!-- Header Chat Unificato -->
            <div v-if="activeChat && activeChat.id" class="flex items-center justify-between border-b pb-4 mb-2 shrink-0">
                <div class="flex items-center w-full max-w-[50%] sm:max-w-[58%]">
                    <button @click="$emit('go-back')" class="mr-3 p-2 lg:hidden bg-gray-100 hover:bg-gray-200 rounded-full transition-colors shrink-0">
                        <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </button>

                    <!-- Avatar e Titolo Standard / Gruppi -->
                    <div v-if="!isAnon" class="flex items-center p-2 rounded-lg transition-colors overflow-hidden flex-grow" 
                         :class="{'cursor-pointer hover:bg-gray-100': activeChat.isGroup}" 
                         @click="$emit('group-info-click')">
                        <div v-html="getAvatar(activeChat.avatarUrl, activeChat.displayName, 'w-12 h-12 mr-4 shrink-0', activeChat.isGroup)"></div>
                        <div class="flex flex-col min-w-0">
                            <h3 class="text-xl sm:text-2xl font-bold text-gray-800 truncate" v-html="activeChat.displayName + (activeChat.isVerified ? verifiedIcon('w-5 h-5 text-blue-500 ml-1 inline-block align-middle') : '')"></h3>
                            <span v-if="activeChat.isGroup" class="text-xs text-gray-500 truncate">Info gruppo</span>
                        </div>
                    </div>

                    <!-- Avatar e Titolo Modalità Anonima -->
                    <div v-else class="flex items-center p-2 rounded-lg transition-colors overflow-hidden flex-grow">
                        <div v-if="!isReceiver" v-html="getAvatar(activeChat.targetAvatarUrl, activeChat.displayTitle, 'w-12 h-12 mr-4 shrink-0', false)"></div>
                        <div v-else class="w-12 h-12 rounded-full flex items-center justify-center bg-purple-100 text-purple-700 mr-4 shrink-0">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>
                        </div>

                        <div class="flex flex-col min-w-0">
                            <h3 class="text-xl sm:text-2xl font-bold text-gray-800 truncate flex items-center gap-1">
                                <span>{{ activeChat.displayTitle }}</span>
                                <span v-if="activeChat.targetIsVerified && !isReceiver" v-html="verifiedIcon('w-5 h-5 text-blue-500 ml-1 inline-block shrink-0')"></span>
                            </h3>
                            <span class="text-xs text-gray-400 truncate">
                                {{ isReceiver ? 'Risposta anonima bidirezionale' : 'I tuoi messaggi vengono inviati come Anonimo' }}
                            </span>
                        </div>
                    </div>
                </div>
                
                <div class="flex items-center space-x-2 shrink-0">
                    <button v-if="isAnon && isReceiver && !activeChat.isBlocked" 
                            @click="$emit('block-thread')" 
                            class="px-3 py-1.5 text-xs font-bold text-red-600 bg-red-50 hover:bg-red-100 rounded-lg transition-colors" 
                            title="Blocca questo utente definitivamente">
                        Blocca
                    </button>

                    <!-- Selettore Modalità Effimera -->
                    <div class="relative" @click.stop>
                        <button type="button" 
                                @click="isEphemeralMenuOpen = !isEphemeralMenuOpen" 
                                :class="['px-3 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-sm border', 
                                         ephemeralDuration > 0 ? 'bg-purple-50 text-purple-700 border-purple-200 hover:bg-purple-100' : 'bg-gray-100 text-gray-600 border-gray-200 hover:bg-gray-200']"
                                title="Configura messaggi effimeri">
                            <span class="text-sm">⏱️</span>
                            <span class="hidden sm:inline">{{ ephemeralDuration > 0 ? getEphemeralLabel.replace('Effimeri: ', '') : 'Effimeri: No' }}</span>
                            <svg class="w-3.5 h-3.5 ml-0.5 transition-transform" :class="{'rotate-180': isEphemeralMenuOpen}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7-7-7-7"/></svg>
                        </button>

                        <div v-if="isEphemeralMenuOpen" class="absolute right-0 mt-2 w-56 bg-white border border-gray-100 rounded-2xl shadow-2xl z-[70] p-2 animate-in fade-in zoom-in-95 duration-150">
                            <div class="px-2.5 py-1.5 border-b border-gray-100 mb-1">
                                <span class="text-[10px] font-extrabold text-gray-400 uppercase tracking-wider block">Modalità Effimera</span>
                                <span class="text-[11px] text-gray-500 leading-tight">Elimina i messaggi dopo il tempo stabilito.</span>
                            </div>

                            <button @click="selectPresetEphemeral(0)" :class="['w-full text-left px-3 py-2 rounded-xl text-xs font-bold flex items-center justify-between transition', ephemeralDuration === 0 ? 'bg-purple-50 text-purple-700' : 'text-gray-700 hover:bg-gray-50']">
                                <span class="flex items-center gap-2"><span>🚫</span> Disattivato</span>
                                <span v-if="ephemeralDuration === 0" class="text-purple-600 font-extrabold">✓</span>
                            </button>

                            <button @click="selectPresetEphemeral(86400)" :class="['w-full text-left px-3 py-2 rounded-xl text-xs font-bold flex items-center justify-between transition', ephemeralDuration === 86400 ? 'bg-purple-50 text-purple-700' : 'text-gray-700 hover:bg-gray-50']">
                                <span class="flex items-center gap-2"><span>⏳</span> 24 Ore</span>
                                <span v-if="ephemeralDuration === 86400" class="text-purple-600 font-extrabold">✓</span>
                            </button>

                            <button @click="selectPresetEphemeral(604800)" :class="['w-full text-left px-3 py-2 rounded-xl text-xs font-bold flex items-center justify-between transition', ephemeralDuration === 604800 ? 'bg-purple-50 text-purple-700' : 'text-gray-700 hover:bg-gray-50']">
                                <span class="flex items-center gap-2"><span>🗓️</span> 7 Giorni</span>
                                <span v-if="ephemeralDuration === 604800" class="text-purple-600 font-extrabold">✓</span>
                            </button>

                            <button @click="selectPresetEphemeral('custom')" class="w-full text-left px-3 py-2 rounded-xl text-xs font-bold flex items-center justify-between text-purple-600 hover:bg-purple-50 transition border-t border-gray-100 mt-1">
                                <span class="flex items-center gap-2"><span>⚡</span> Personalizzato...</span>
                                <span v-if="![0, 86400, 604800].includes(ephemeralDuration)" class="text-[10px] bg-purple-100 px-1.5 py-0.5 rounded font-extrabold">Attivo</span>
                            </button>
                        </div>
                    </div>

                    <!-- Programmazione Invio -->
                    <button type="button" 
                            @click="$emit('open-schedule-modal')" 
                            :class="['p-2.5 bg-gray-100 rounded-xl text-gray-600 transition border border-gray-200', isAnon ? 'hover:bg-purple-50 hover:text-purple-600' : 'hover:bg-blue-50 hover:text-blue-600']" 
                            title="Programma Invio Messaggio">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </button>

                    <!-- Sfondo -->
                    <select :value="selectedBg" 
                            @input="$emit('update:selectedBg', $event.target.value)" 
                            @change="$emit('change-bg')" 
                            :class="['text-xs sm:text-sm p-2 border border-gray-300 rounded-xl bg-white focus:outline-none focus:ring-2 cursor-pointer max-w-[110px] sm:max-w-none truncate', isAnon ? 'focus:ring-purple-500' : 'focus:ring-blue-500']">
                        <option value="default">Sfondo Default</option>
                        <option v-for="color in bgOptions" :key="color.hex" :value="color.hex">{{ color.nome }}</option>
                        <option value="custom">Personalizzato...</option>
                    </select>
                    <input type="file" id="bg-upload-input" @change="$emit('upload-custom-bg', $event)" class="hidden" accept="image/*">
                </div>
            </div>

            <!-- Banner Informativo Modalità Effimera Attiva -->
            <div v-if="activeChat && activeChat.id && ephemeralDuration > 0" class="mb-2 px-3.5 py-2 bg-gradient-to-r from-purple-500/10 via-purple-500/5 to-transparent border-l-4 border-purple-600 rounded-r-xl flex items-center justify-between text-xs text-purple-900 shadow-sm shrink-0">
                <div class="flex items-center gap-2">
                    <span class="text-sm">⏱️</span>
                    <span>Messaggi effimeri attivi: scompariranno dopo <strong>{{ getEphemeralLabel.replace('Effimeri: ', '') }}</strong>.</span>
                </div>
                <button @click="selectPresetEphemeral(0)" class="text-[10px] font-extrabold text-purple-600 hover:underline uppercase">Disattiva</button>
            </div>

            <!-- Banner Messaggio Fissato nei Gruppi -->
            <div v-if="!isAnon && activeChat.isGroup && pinnedMessage" @click="$emit('scroll-to-msg', pinnedMessage.id)" class="mb-3 px-3 py-2 bg-blue-50/80 border-l-4 border-blue-600 rounded-r-xl flex items-center justify-between cursor-pointer hover:bg-blue-100 transition shadow-sm shrink-0">
                <div class="flex items-center gap-2 overflow-hidden">
                    <span class="text-blue-600 text-sm">📌</span>
                    <div class="truncate text-xs">
                        <span class="font-bold text-blue-900">{{ pinnedMessage.senderName }}:</span>
                        <span class="text-gray-700 ml-1">{{ pinnedMessage.textSnippet }}</span>
                    </div>
                </div>
                <span class="text-[10px] text-blue-600 font-bold uppercase shrink-0 ml-2">Fissato</span>
            </div>

            <!-- Contenitore Messaggi -->
            <div id="messages-container" @scroll="$emit('scroll-messages', $event)" class="flex-grow overflow-y-auto space-y-4 p-4 border rounded-2xl mb-4 custom-scrollbar transition-all duration-300" :style="bgStyle">
                <p v-if="!activeChat || !activeChat.id" class="text-gray-500 text-center text-lg my-auto h-full flex items-center justify-center">
                    {{ isAnon ? 'Seleziona una chat anonima per visualizzare i messaggi.' : 'Seleziona una chat o un gruppo per iniziare.' }}
                </p>
                
                <template v-else>
                    <div v-if="hasMoreMessages" class="flex justify-center py-2">
                        <button @click="$emit('load-older')" :disabled="isLoadingMore" :class="['text-xs bg-white px-3.5 py-1.5 rounded-full border shadow-sm transition-all font-bold flex items-center gap-1.5', isAnon ? 'text-purple-600 border-purple-200 hover:bg-purple-50' : 'text-blue-600 border-blue-200 hover:bg-blue-50']">
                            <svg v-if="isLoadingMore" :class="['animate-spin h-3.5 w-3.5', isAnon ? 'text-purple-600' : 'text-blue-600']" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                            <span>{{ isLoadingMore ? 'Caricamento...' : 'Carica precedenti (5)' }}</span>
                        </button>
                    </div>

                    <div v-for="(msg) in messages" :key="msg.id" :id="'msg-' + msg.id">
                        <div v-if="msg.showDateSeparator" class="flex justify-center my-6">
                            <div :class="['text-xs font-bold px-4 py-1.5 rounded-full shadow-sm border uppercase tracking-wider', isAnon ? 'bg-purple-50 text-purple-700 border-purple-100' : 'bg-blue-50 text-blue-600 border-blue-100']">{{ msg.dateLabel }}</div>
                        </div>

                        <div :class="['w-full flex mb-3 px-2 items-start gap-2.5', msg.isMe ? 'justify-end' : 'justify-start']">
                            <!-- Avatar Mittente -->
                            <div v-if="!msg.isMe">
                                <template v-if="isAnon">
                                    <div v-if="isReceiver" class="w-8 h-8 rounded-full bg-purple-100 text-purple-700 flex items-center justify-center shrink-0 text-xs font-bold mt-0.5 border border-purple-200">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>
                                    </div>
                                    <div v-else v-html="getAvatar(activeChat.targetAvatarUrl, activeChat.displayTitle, 'w-8 h-8 mt-0.5 text-xs shrink-0', false)"></div>
                                </template>
                                <div v-else v-html="getAvatar(msg.senderAvatar, msg.senderName, msg.senderName === 'Sistema' ? 'w-8 h-8 mt-0.5 text-xs !bg-gray-400 !bg-none' : 'w-8 h-8 mt-0.5 text-xs', false)"></div>
                            </div>
                            
                            <!-- Bolla Messaggio -->
                            <div :class="['relative w-fit max-w-[85%] sm:max-w-[55%] px-4 py-2.5 shadow-sm flex flex-col group transition-all duration-200', msg.isMe ? (isAnon ? 'bg-purple-600 text-white rounded-2xl rounded-tr-none' : 'bg-blue-600 text-white rounded-2xl rounded-tr-none') : 'bg-white text-gray-800 rounded-2xl rounded-tl-none border border-gray-200']">
                                
                                <!-- Azioni Rapide Hover -->
                                <div :class="['absolute top-2 opacity-0 group-hover:opacity-100 transition-opacity duration-150 z-20 flex gap-1', msg.isMe ? (activeChat.isGroup ? '-left-24' : '-left-20') : (activeChat.isGroup ? '-right-24' : '-right-20')]">
                                    <button @click.stop="$emit('start-reply', msg)" title="Rispondi" :class="['p-1.5 bg-white text-gray-500 hover:bg-gray-100 rounded-full shadow border border-gray-200', isAnon ? 'hover:text-purple-600' : 'hover:text-blue-600']">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a5 5 0 015 5v3M3 10l6-6m-6 6l6 6"/></svg>
                                    </button>
                                    <button v-if="!isAnon && activeChat.isGroup" @click.stop="$emit('toggle-pin-msg', msg)" title="Fissa/Sfissa nel gruppo" class="p-1.5 bg-white text-gray-500 hover:text-yellow-600 hover:bg-gray-100 rounded-full shadow border border-gray-200">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                                    </button>
                                    <button @click.stop="$emit('toggle-dropdown', msg.id)" title="Altre opzioni" class="p-1.5 bg-white text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-full shadow border border-gray-200">
                                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 10a2 2 0 100 4 2 2 0 000-4zM12 4a2 2 0 100 4 2 2 0 000-4zM12 16a2 2 0 100 4 2 2 0 000-4z"/></svg>
                                    </button>
                                    
                                    <div v-if="openDropdownId === msg.id" class="absolute left-0 mt-8 w-44 bg-white rounded-xl shadow-2xl border border-gray-200 z-50 overflow-hidden text-sm py-1">
                                        <button v-if="msg.isMe" @click="$emit('view-msg-info', msg)" :class="['w-full text-left px-3 py-2 text-gray-700 flex items-center gap-2', isAnon ? 'hover:bg-purple-50 hover:text-purple-600' : 'hover:bg-blue-50 hover:text-blue-600']">
                                            <svg :class="['w-4 h-4', isAnon ? 'text-purple-500' : 'text-blue-500']" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                            Info messaggio
                                        </button>
                                        <button v-if="msg.isMe && !msg.isDeleted" @click="$emit('start-edit', msg)" :class="['w-full text-left px-3 py-2 text-gray-700 flex items-center gap-2', isAnon ? 'hover:bg-purple-50 hover:text-purple-600' : 'hover:bg-blue-50 hover:text-blue-600']">
                                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                            Modifica
                                        </button>
                                        <button @click="$emit('delete-for-me', msg.id)" class="w-full text-left px-3 py-2 text-gray-700 hover:bg-orange-50 hover:text-orange-600 flex items-center gap-2 border-t border-gray-100">
                                            <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            Elimina per me
                                        </button>
                                        <button v-if="msg.isMe && !msg.isDeleted" @click="$emit('delete-for-everyone', msg.id)" class="w-full text-left px-3 py-2 text-red-600 hover:bg-red-50 flex items-center gap-2 border-t border-gray-100">
                                            <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            Elimina per tutti
                                        </button>
                                        <!-- Pulsante Segnala Messaggio (Solo per messaggi altrui) -->
                                        <button v-if="!msg.isMe && !msg.isDeleted && msg.senderName !== 'Sistema'" 
                                                @click="triggerReportMessage(msg)" 
                                                class="w-full text-left px-3 py-2 text-red-600 hover:bg-red-50 font-semibold flex items-center gap-2 border-t border-gray-100">
                                            <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/></svg>
                                            Segnala messaggio
                                        </button>
                                    </div>
                                </div>

                                <!-- Intestazione Nome Mittente -->
                                <span v-if="!msg.isMe && isAnon" class="text-[10px] font-bold text-purple-600 block mb-1">
                                    {{ isReceiver ? 'Anonimo' : activeChat.displayTitle }}
                                </span>
                                <span v-else-if="!msg.isMe && activeChat.isGroup && msg.senderName !== 'Sistema'" class="text-[10px] font-bold text-green-600 block mb-1" v-html="msg.senderName + (msg.isSenderVerified ? verifiedIcon('w-3.5 h-3.5 inline-block ml-0.5') : '')"></span>

                                <!-- Quote Risposta -->
                                <div v-if="msg.replyTo" @click="$emit('scroll-to-msg', msg.replyTo.id)" :class="['mb-2 p-2 rounded-lg text-xs cursor-pointer border-l-4 overflow-hidden', isAnon ? 'border-purple-400' : 'border-blue-400', msg.isMe ? (isAnon ? 'bg-purple-700/50 text-purple-100' : 'bg-blue-700/50 text-blue-100') : 'bg-gray-100 text-gray-600']">
                                    <span class="font-bold block text-[11px]">{{ msg.replyTo.senderName }}</span>
                                    <p class="truncate text-[11px] opacity-90">{{ msg.replyTo.text }}</p>
                                </div>

                                <!-- Vocale Monouso -->
                                <div v-if="msg.isViewOnce" class="py-1">
                                    <div v-if="msg.isListened" class="text-xs italic opacity-75 flex items-center gap-1">
                                        <span>🎧 Vocale monouso già ascoltato</span>
                                    </div>
                                    <div v-else class="flex items-center gap-2">
                                        <span class="text-xs font-bold bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full border border-amber-200">1x Monouso</span>
                                        <div @click="$emit('play-view-once', msg)" v-html="msg.contentHtml"></div>
                                    </div>
                                </div>

                                <!-- Testo Normale -->
                                <div v-else-if="editingMsgId !== msg.id" v-html="msg.contentHtml" class="break-words"></div>
                                
                                <!-- Modifica in linea -->
                                <div v-else class="w-full min-w-[200px] mt-1 text-gray-800">
                                    <textarea :value="editMsgText" @input="$emit('update:editMsgText', $event.target.value)" :class="['w-full p-2 text-sm rounded-lg border focus:outline-none focus:ring-2 bg-white', isAnon ? 'border-purple-300 focus:ring-purple-500' : 'border-blue-300 focus:ring-blue-500']" rows="2"></textarea>
                                    <div class="flex justify-end gap-1.5 mt-2">
                                        <button @click="$emit('cancel-edit')" class="px-2 py-1 text-xs font-semibold bg-gray-100 text-gray-600 rounded">Annulla</button>
                                        <button @click="$emit('save-edit', msg.id)" :class="['px-2 py-1 text-xs font-semibold text-white rounded', isAnon ? 'bg-purple-600' : 'bg-blue-600']">Salva</button>
                                    </div>
                                </div>

                                <!-- Reazioni Emoji -->
                                <div v-if="Object.keys(msg.reactions || {}).length > 0" class="flex flex-wrap gap-1 mt-1.5">
                                    <span v-for="(users, emoji) in msg.reactions" :key="emoji" @click="$emit('toggle-reaction', msg, emoji)" :class="['text-xs px-2 py-0.5 rounded-full cursor-pointer border transition-transform active:scale-90', users.includes(getCurrentUid()) ? (isAnon ? 'bg-purple-100 border-purple-300 text-purple-800' : 'bg-blue-100 border-blue-300 text-blue-800') : 'bg-white/80 border-gray-200 text-gray-700']">
                                        {{ emoji }} {{ users.length }}
                                    </span>
                                </div>

                                <div class="hidden group-hover:flex gap-1.5 mt-1 pt-1 border-t border-white/20 text-xs">
                                    <button v-for="emoji in ['👍', '❤️', '😂', '🔥', '👏']" :key="emoji" @click="$emit('toggle-reaction', msg, emoji)" class="hover:scale-125 transition-transform">{{ emoji }}</button>
                                </div>

                                <!-- Footer Bolla -->
                                <div class="flex justify-end items-center mt-1.5 gap-1.5">
                                    <span v-if="msg.isEphemeral" 
                                          :class="['text-[10px] font-bold px-1.5 py-0.2 rounded-md flex items-center gap-0.5', 
                                                   msg.isExpiringSoon ? 'bg-amber-400/90 text-amber-950 animate-pulse font-extrabold' : (msg.isMe ? (isAnon ? 'bg-purple-700/60 text-purple-100' : 'bg-blue-700/60 text-blue-100') : 'bg-gray-100 text-gray-600')]" 
                                          :title="'Scadenza programmata: ' + msg.expiresInText">
                                        <span>⏱️</span>
                                        <span>{{ msg.expiresInText || 'Effimero' }}</span>
                                    </span>

                                    <span v-if="msg.isScheduled" title="Messaggio Programmato" class="text-[10px] opacity-75">📅</span>
                                    <span v-if="msg.isEdited && !msg.isDeleted" class="text-[10px] italic opacity-75">(modificato)</span>
                                    <span :class="['text-[10px] font-medium', msg.isMe ? (isAnon ? 'text-purple-200' : 'text-blue-200') : 'text-gray-400']">{{ msg.timeStr }}</span>
                                    
                                    <span v-if="msg.isMe && !msg.isDeleted" class="flex items-center">
                                        <svg v-if="!msg.isDelivered" :class="['w-3.5 h-3.5 opacity-70', isAnon ? 'text-purple-300' : 'text-blue-300']" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                                        <svg v-else-if="msg.isRead" class="w-4 h-4 text-cyan-300" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M2 13l4 4L16 7M8 13l4 4L22 7"></path></svg>
                                        <svg v-else :class="['w-4 h-4 opacity-80', isAnon ? 'text-purple-200' : 'text-blue-200']" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M2 13l4 4L16 7M8 13l4 4L22 7"></path></svg>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>
            </div>

            <!-- Avviso Thread Anonimo Bloccato -->
            <div v-if="isAnon && activeChat && activeChat.isBlocked" class="p-3 bg-red-50 text-red-600 text-xs rounded-xl text-center font-semibold mb-2">
                Questa conversazione anonima è stata bloccata. Non è possibile inviare altri messaggi.
            </div>

            <!-- Avviso Limite 2 Messaggi Consecutivi (Solo Anonimo) -->
            <div v-else-if="isAnon && activeChat && activeChat.id && isAnonWaitingForReply" class="p-3 bg-amber-50 border border-amber-200 text-amber-800 text-xs rounded-xl text-center font-medium mb-2 flex items-center justify-center gap-2">
                <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <span>Hai inviato 2 messaggi consecutivi. Attendi che l'utente risponda prima di poterne scrivere altri.</span>
            </div>

            <!-- Menzioni (Solo Gruppi) -->
            <div v-if="!isAnon && mentionResults.length > 0" class="absolute bottom-20 left-4 bg-white border border-gray-200 rounded-lg shadow-2xl z-[60] max-h-48 overflow-y-auto w-64 flex flex-col">
                <div v-for="user in mentionResults" :key="user.username" @click="$emit('insert-mention', user.username)" class="p-3 hover:bg-green-50 cursor-pointer text-sm font-semibold border-b border-gray-100 flex items-center gap-2">
                    <div v-html="getAvatar(user.userPfUri, user.username, 'w-6 h-6', false)"></div> @{{ user.username }}
                </div>
            </div>

            <!-- Banner Risposta -->
            <div v-if="replyingTo" :class="['flex items-center justify-between p-2.5 mb-2 border-l-4 rounded-r-lg', isAnon ? 'bg-purple-50 border-purple-500' : 'bg-blue-50 border-blue-500']">
                <div class="overflow-hidden">
                    <p :class="['text-xs font-bold', isAnon ? 'text-purple-700' : 'text-blue-700']">
