                                    {{ isSubmittingAppeal ? t('appealModalSubmitting', 'Invio in corso...') : t('appealModalSubmit', 'Invia') }}
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    `
};
