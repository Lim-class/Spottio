<file path="spotini/spotini.css">
/* spotini.css - Stili dedicati per gli Spotini (Shorts / Reels) */

/* 1. Azzeramento forzato e totale di scrollbar e binari su qualsiasi browser */
html, body, #vue-spotini-app, .spotini-container, .spotino-card, .spotino-media-wrapper {
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
}

html::-webkit-scrollbar,
body::-webkit-scrollbar,
#vue-spotini-app::-webkit-scrollbar,
.spotini-container::-webkit-scrollbar,
.spotino-card::-webkit-scrollbar,
*::-webkit-scrollbar {
    display: none !important;
    width: 0px !important;
    height: 0px !important;
    background: transparent !important;
    -webkit-appearance: none !important;
}

/* 2. Contenitore principale verticale con snap scroll nativo */
.spotini-container {
    scroll-snap-type: y mandatory;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    height: 100vh;
    height: 100dvh;
    touch-action: pan-y;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-y: contain;
    border: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    background-color: #000000 !important;
}

/* 3. Card singola */
.spotino-card {
    scroll-snap-align: start;
    scroll-snap-stop: always;
    height: 100vh;
    height: 100dvh;
    width: 100%;
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000000 !important;
    overflow: hidden !important;
    border: 0 !important;
    outline: none !important;
    box-shadow: none !important;
}

/* 4. Elemento Video / Media */
.spotino-media-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000000 !important;
    border: 0 !important;
    outline: none !important;
}

.spotino-video,
.spotino-image {
    width: 100%;
    height: 100%;
    max-height: 100vh;
    max-height: 100dvh;
    object-fit: cover;
    pointer-events: none;
    border: 0 !important;
    outline: none !important;
    background-color: #000000 !important;
}

/* 5. Colonna laterale bottoni: nessun bordo o ombra sovrapposta */
.spotini-actions-column {
    border: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    pointer-events: auto !important;
}

.spotini-actions-column * {
    border: 0 !important;
    outline: none !important;
}

/* Gradienti per leggibilità */
.gradient-overlay-bottom {
    background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.5) 40%, rgba(0,0,0,0) 100%);
    border: 0 !important;
}

.gradient-overlay-top {
    background: linear-gradient(to bottom, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 100%);
    border: 0 !important;
}

/* Animazione Like */
@keyframes popHeart {
    0% { transform: scale(0) rotate(-15deg); opacity: 0; }
    50% { transform: scale(1.3) rotate(0deg); opacity: 0.95; }
    100% { transform: scale(1) rotate(10deg); opacity: 0; }
}

.animate-double-tap-heart {
    animation: popHeart 0.8s ease-out forwards;
}

/* Scrubber / Avanzamento video */
.scrubber-container {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 16px;
    z-index: 40;
    display: flex;
    align-items: flex-end;
    cursor: pointer;
    touch-action: none;
    padding-bottom: 2px;
}

.scrubber-track {
    width: 100%;
    height: 3px;
    background-color: rgba(255, 255, 255, 0.25);
    position: relative;
    transition: height 0.15s ease;
}

.scrubber-container:hover .scrubber-track,
.scrubber-container.is-scrubbing .scrubber-track {
    height: 6px;
}

.scrubber-progress {
    height: 100%;
    background-color: #ffffff;
    width: 0%;
    position: relative;
    pointer-events: none;
}

.scrubber-thumb {
    position: absolute;
    right: -5px;
    top: 50%;
    transform: translateY(-50%) scale(0);
    width: 12px;
    height: 12px;
    background-color: #ffffff;
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(0,0,0,0.6);
    transition: transform 0.15s ease;
}

.scrubber-container:hover .scrubber-thumb,
.scrubber-container.is-scrubbing .scrubber-thumb {
    transform: translateY(-50%) scale(1);
}

/* Seek feedback doppio tocco */
.seek-feedback {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 35%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    pointer-events: none;
    z-index: 35;
    animation: seekFade 0.6s ease-out forwards;
}

.seek-feedback.left { left: 0; }
.seek-feedback.right { right: 0; }

@keyframes seekFade {
    0% { opacity: 0; transform: scale(0.85); }
    40% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.1); }
}
</file>

<file path="spotini/spotini.html">
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Spotini</title>
    <link rel="icon" href="https://i.ibb.co/b5HgvzCB/Spottio-Logo-2.png" type="image/png">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="../impostazioni/body.css">
    <link rel="stylesheet" href="spotini.css">
</head>
<body class="flex min-h-screen bg-black text-white select-none overflow-hidden">

    <!-- Navigazione Spottio Desktop -->
    <div id="sidebar-container" class="hidden md:flex w-1/5 bg-white p-6 rounded-r-2xl shadow-xl flex-col justify-start items-start sticky top-0 h-screen overflow-y-auto custom-scrollbar transition-all duration-300 z-40 text-gray-800">
        <h2 id="menu-title" class="text-2xl font-bold text-gray-800 mb-6 w-full"></h2>
        <div id="nav-container" class="w-full"></div>
    </div>

    <!-- APP VUE PRINCIPALE SPOTINI -->
    <div id="vue-spotini-app" v-cloak class="flex-grow flex justify-center items-center h-screen w-full relative bg-black overflow-hidden">
        
        <!-- FEED VERTICALE SNAP -->
        <div 
            ref="containerRef" 
            class="spotini-container w-full max-w-[440px] relative bg-black flex flex-col">
            
            <!-- HEADER FLUTTUANTE: TABS + Global Mute -->
            <div class="absolute top-0 left-0 right-0 w-full z-30 flex justify-between items-center px-4 py-4 gradient-overlay-top pointer-events-none">
                <a href="../spot/spot.html" class="pointer-events-auto text-white/80 hover:text-white p-2 rounded-full bg-black/40 backdrop-blur-md md:hidden cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
                    </svg>
                </a>

                <div class="flex items-center space-x-4 pointer-events-auto mx-auto font-semibold text-base drop-shadow-md">
                    <button 
                        @click="switchFeedMode('explore')"
                        :class="feedMode === 'explore' ? 'text-white border-b-2 border-white pb-0.5 font-bold' : 'text-white/60 hover:text-white/80 cursor-pointer'">
                        {{ translateText('tabExplore', 'Esplora') }}
                    </button>
                    <span class="text-white/30 text-xs">|</span>
                    <button 
                        @click="switchFeedMode('following')"
                        :class="feedMode === 'following' ? 'text-white border-b-2 border-white pb-0.5 font-bold' : 'text-white/60 hover:text-white/80 cursor-pointer'">
                        {{ translateText('tabFollowing', 'Seguiti') }}
                    </button>
                </div>

                <button @click="toggleGlobalMute" class="pointer-events-auto p-2 rounded-full bg-black/40 backdrop-blur-md text-white/90 hover:text-white hover:bg-black/60 transition shadow-sm cursor-pointer">
                    <svg v-if="isMuted" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
                    </svg>
                    <svg v-else xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                    </svg>
                </button>
            </div>

            <!-- STATO VUOTO -->
            <div v-if="!isInitialLoading && spotiniList.length === 0" class="h-screen flex flex-col items-center justify-center text-center p-8 space-y-4">
                <div class="w-20 h-20 rounded-full bg-neutral-900 flex items-center justify-center text-neutral-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                </div>
                <h3 class="text-lg font-semibold text-white">{{ translateText('noSpotiniFound', 'Nessuno spotino trovato') }}</h3>
                <p class="text-xs text-neutral-400 max-w-xs">{{ emptyMessage || translateText('noSpotiniTag', 'Non ci sono contenuti con il tag #spotini.') }}</p>
                <button @click="switchFeedMode('explore')" class="px-5 py-2.5 rounded-full bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 transition cursor-pointer">
                    {{ translateText('exploreContentBtn', 'Esplora contenuti') }}
                </button>
            </div>

            <!-- CARICAMENTO INIZIALE -->
            <div v-if="isInitialLoading" class="h-screen flex items-center justify-center">
                <div class="animate-spin rounded-full h-12 w-12 border-4 border-blue-500 border-t-transparent"></div>
            </div>

            <!-- CARD SPOTINO -->
            <div 
                v-for="(spot, index) in spotiniList" 
                :key="spot.id"
                :data-index="index"
                class="spotino-card">

                <!-- CONTENITORE MEDIA -->
                <div class="spotino-media-wrapper cursor-pointer" @click="handleScreenTap(spot, $event)">
                    <video 
                        v-if="spot.mediaItem?.isVideo || spot.isVideo" 
                        :id="'spotino-video-' + index"
                        :src="spot.mediaItem?.url || spot.videoUrl"
                        loop 
                        playsinline 
                        webkit-playsinline
                        :muted="isMuted"
                        @timeupdate="updateVideoProgress($event, spot)"
                        class="spotino-video">
                    </video>

                    <img 
                        v-else-if="spot.mediaItem?.url" 
                        :src="spot.mediaItem.url" 
                        class="spotino-image"
                        alt="Spotino">

                    <div v-else class="w-full h-full bg-gradient-to-tr from-indigo-900 via-purple-900 to-pink-800 p-8 flex items-center justify-center text-center pointer-events-none">
                        <p class="text-2xl md:text-3xl font-bold text-white drop-shadow-2xl leading-snug">
                            {{ spot.data.text }}
                        </p>
                    </div>
                </div>

                <!-- SEEK FEEDBACK -->
                <div v-if="spot.seekFeedback === 'backward'" class="seek-feedback left">
                    <svg class="w-10 h-10 text-white drop-shadow-lg" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M11 18V6l-8.5 6 8.5 6zm.5-6l8.5 6V6l-8.5 6z"/>
                    </svg>
                    <span class="text-xs font-semibold text-white mt-1">-5s</span>
                </div>
                <div v-if="spot.seekFeedback === 'forward'" class="seek-feedback right">
                    <svg class="w-10 h-10 text-white drop-shadow-lg" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4 18l8.5-6L4 6v12zm9-12v12l8.5-6L13 6z"/>
                    </svg>
                    <span class="text-xs font-semibold text-white mt-1">+5s</span>
                </div>

                <!-- ANIMAZIONE CUORE LIKE -->
                <div v-if="spot.showHeartAnim" class="absolute inset-0 pointer-events-none flex items-center justify-center z-30">
                    <svg class="w-28 h-28 text-red-500 fill-current animate-double-tap-heart drop-shadow-2xl" viewBox="0 0 24 24">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c3.08 0 5.5 2.42 5.5 5.5 0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                </div>

                <!-- INDICATORE PAUSA -->
                <div v-if="spot.isPaused" class="absolute inset-0 pointer-events-none flex items-center justify-center z-20 bg-black/20">
                    <div class="w-16 h-16 rounded-full bg-black/60 backdrop-blur-md flex items-center justify-center text-white/90">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 ml-1" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M8 5v14l11-7z"/>
                        </svg>
                    </div>
                </div>

                <!-- AZIONI LATERALI DESTRA -->
                <div class="spotini-actions-column absolute right-3 bottom-14 z-30 flex flex-col items-center space-y-5">
                    <!-- Like -->
                    <div class="flex flex-col items-center">
                        <button 
                            @click.stop="toggleLike(spot)" 
                            :class="['p-3 rounded-full bg-black/40 backdrop-blur-md hover:bg-black/60 active:scale-125 transition duration-200 cursor-pointer', spot.hasLiked ? 'text-red-500' : 'text-white']">
                            <svg class="w-7 h-7" :fill="spot.hasLiked ? 'currentColor' : 'none'" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                            </svg>
                        </button>
                        <span class="text-xs font-semibold text-white drop-shadow mt-1 cursor-pointer" @click.stop="openLikesModal(spot.data.likes)">
                            {{ formatCounter(spot.data.likes?.length || 0) }}
                        </span>
                    </div>

                    <!-- Commenti -->
                    <div class="flex flex-col items-center">
                        <button 
                            @click.stop="openCommentsDrawer(spot)" 
                            class="p-3 rounded-full bg-black/40 backdrop-blur-md text-white hover:bg-black/60 active:scale-110 transition cursor-pointer">
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                            </svg>
                        </button>
                        <span class="text-xs font-semibold text-white drop-shadow mt-1">
                            {{ formatCounter(spot.data.comments?.length || 0) }}
                        </span>
                    </div>

                    <!-- Condivisione -->
                    <div class="flex flex-col items-center">
                        <button 
                            @click.stop="sharePost(spot.id, spot.data.text)" 
                            class="p-3 rounded-full bg-black/40 backdrop-blur-md text-white hover:bg-black/60 active:scale-110 transition cursor-pointer">
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                            </svg>
                        </button>
                        <span class="text-[11px] font-semibold text-white drop-shadow mt-1">{{ translateText('shareBtn', 'Condividi') }}</span>
                    </div>

                    <!-- MENU A 3 PUNTINI -->
                    <div class="relative" @click.stop>
                        <button 
                            @click="toggleOptions(spot.id, $event)" 
                            class="p-3 rounded-full bg-black/40 backdrop-blur-md text-white hover:bg-black/60 active:scale-110 transition cursor-pointer"
                            title="Opzioni">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 10a2 2 0 100 4 2 2 0 000-4zM12 4a2 2 0 100 4 2 2 0 000-4zM12 16a2 2 0 100 4 2 2 0 000-4z" />
                            </svg>
                        </button>

                        <div v-if="activeOptionsSpotId === spot.id" class="absolute right-0 bottom-full mb-2 w-44 bg-white text-gray-800 rounded-2xl shadow-2xl py-1.5 z-50 text-xs border border-gray-100 animate-in fade-in duration-100">
                            <!-- Segnala -->
                            <button v-if="session.uid" @click="closeOptions(); triggerReportFromOptions(spot)" class="w-full text-left px-3.5 py-2 hover:bg-yellow-50 text-gray-700 hover:text-yellow-700 flex items-center gap-2 font-medium transition cursor-pointer">
                                <svg class="w-4 h-4 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.332 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                <span>{{ translateText('reportBtn', 'Segnala') }}</span>
                            </button>

                            <!-- Modifica -->
                            <button v-if="canManageSpot(spot)" @click="closeOptions(); triggerEditFromOptions(spot)" class="w-full text-left px-3.5 py-2 hover:bg-blue-50 text-gray-700 hover:text-blue-600 flex items-center gap-2 font-medium transition cursor-pointer">
                                <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                <span>{{ translateText('editPostBtn', 'Modifica') }}</span>
                            </button>

                            <!-- Elimina -->
                            <button v-if="canManageSpot(spot) || session.isAdmin" @click="closeOptions(); deleteSpotino(spot)" class="w-full text-left px-3.5 py-2 hover:bg-red-50 text-red-600 flex items-center gap-2 font-medium transition border-t border-gray-100 cursor-pointer">
                                <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                <span>{{ translateText('deletePostBtn', 'Elimina') }}</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- OVERLAY INFORMAZIONI AUTORE -->
                <div class="absolute bottom-3 left-0 right-16 p-4 z-20 gradient-overlay-bottom flex flex-col justify-end text-left pointer-events-none">
                    <div class="flex items-center gap-2.5 mb-2 pointer-events-auto">
                        <div class="flex items-center -space-x-2">
                            <a :href="'../utente/utente.html?uid=' + spot.data.user" class="block shrink-0">
                                <div v-html="getUserAvatarHtml(spot.authorProfile?.userPfUri, spot.authorProfile?.username, 'w-9 h-9 border border-white/60')"></div>
                            </a>
                            <template v-if="spot.coAuthorProfiles && spot.coAuthorProfiles.length > 0">
                                <a v-for="co in spot.coAuthorProfiles" :key="co.uid" :href="'../utente/utente.html?uid=' + co.uid" class="block shrink-0">
                                    <div v-html="getUserAvatarHtml(co.userPfUri, co.username, 'w-9 h-9 border-2 border-white')"></div>
                                </a>
                            </template>
                        </div>
                        
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <a :href="'../utente/utente.html?uid=' + spot.data.user" class="font-semibold text-white text-sm hover:underline drop-shadow">
                                {{ spot.authorProfile?.username || translateText('anonymousUser', 'Anonimo') }}
                            </a>
                            <span v-if="spot.authorProfile?.isVerified" v-html="getVerifiedBadge()"></span>

                            <template v-if="spot.coAuthorProfiles && spot.coAuthorProfiles.length > 0">
                                <span class="text-white/60 text-xs">&</span>
                                <a v-for="co in spot.coAuthorProfiles" :key="co.uid" :href="'../utente/utente.html?uid=' + co.uid" class="font-semibold text-purple-300 hover:underline text-xs">
                                    @{{ co.username }}
                                </a>
                            </template>
                            
                            <button 
                                v-if="spot.data.user !== session.uid && !spot.isFollowing" 
                                @click.stop="quickFollow(spot)" 
                                class="ml-1.5 border border-white/80 hover:bg-white hover:text-black text-white text-xs font-semibold px-2.5 py-0.5 rounded-lg backdrop-blur-sm transition cursor-pointer">
                                {{ translateText('followBtn', 'Segui') }}
                            </button>
                        </div>
                    </div>

                    <!-- Didascalia (Nessun badge/tag visibile) -->
                    <div class="pointer-events-auto flex flex-col items-start gap-1">
                        <p :class="['text-xs text-neutral-100 font-normal leading-relaxed drop-shadow-md break-words', spot.isExpandedText ? '' : 'line-clamp-2']">
                            {{ spot.data.text }}
                        </p>
                        <button 
                            v-if="spot.data.text && spot.data.text.length > 80" 
                            @click.stop="spot.isExpandedText = !spot.isExpandedText" 
                            class="text-[11px] font-semibold text-neutral-300 hover:text-white cursor-pointer">
                            {{ spot.isExpandedText ? translateText('lessText', 'Meno') : translateText('moreText', 'Altro...') }}
                        </button>
                    </div>

                    <!-- Traccia Audio -->
                    <div class="flex items-center gap-2 mt-2 text-[11px] text-neutral-300 pointer-events-auto">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 animate-spin" style="animation-duration: 4s;" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                        </svg>
                        <span class="truncate max-w-[180px]">{{ spot.authorProfile?.username }} • {{ translateText('originalAudio', 'Audio originale') }}</span>
                    </div>
                </div>

                <!-- BARRA INTERATTIVA SCRUBBER -->
                <div 
                    v-if="spot.mediaItem?.isVideo || spot.isVideo" 
                    :id="'scrubber-' + spot.id"
                    @mousedown.stop="startScrub($event, spot)"
                    @touchstart.stop="startScrub($event, spot)"
                    :class="['scrubber-container', spot.isScrubbing ? 'is-scrubbing' : '']">
                    <div class="scrubber-track">
                        <div class="scrubber-progress" :style="{ width: (spot.progress || 0) + '%' }">
                            <div class="scrubber-thumb"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sentinella Scroll Infinito -->
            <div ref="sentinelRef" class="h-14 w-full flex justify-center items-center py-4 bg-black shrink-0">
                <div v-if="isLoadingMore" class="animate-spin rounded-full h-6 w-6 border-2 border-blue-500 border-t-transparent"></div>
            </div>
        </div>

        <!-- DRAWER MODALE COMMENTI -->
        <div 
            v-if="drawerComments.show" 
            class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex flex-col justify-end"
            @click.self="drawerComments.show = false">
            
            <div class="bg-neutral-900 border-t border-neutral-800 rounded-t-3xl max-w-[440px] w-full mx-auto h-[65vh] flex flex-col shadow-2xl transition-transform text-white">
                <div class="p-4 border-b border-neutral-800 flex justify-between items-center relative">
                    <div class="w-10 h-1 bg-neutral-700 rounded-full absolute top-2 left-1/2 -translate-x-1/2"></div>
                    <h3 class="font-semibold text-white text-sm mt-1">{{ translateText('commentsTitle', 'Commenti') }} ({{ drawerComments.currentSpot?.data?.comments?.length || 0 }})</h3>
                    <button @click="drawerComments.show = false" class="text-neutral-400 hover:text-white text-lg p-1 cursor-pointer">✕</button>
                </div>

                <div class="flex-grow overflow-y-auto p-4 space-y-3 custom-scrollbar">
                    <div v-if="!drawerComments.currentSpot?.data?.comments || drawerComments.currentSpot?.data?.comments.length === 0" class="text-center py-12 text-sm text-neutral-500">
                        {{ translateText('emptyCommentPrompt', 'Nessun commento disponibile. Condividi cosa ne pensi per primo!') }}
                    </div>

                    <div 
                        v-for="(comment, cIdx) in drawerComments.currentSpot?.data?.comments" 
                        :key="cIdx" 
                        class="flex items-start space-x-3 text-sm p-2 rounded-xl hover:bg-neutral-800/40 transition group">
                        <div v-html="getUserAvatarHtml(comment.authorProfile?.userPfUri, comment.authorProfile?.username, 'w-8 h-8 rounded-full text-xs')"></div>
                        <div class="flex-grow min-w-0">
                            <div class="flex justify-between items-baseline mb-0.5">
                                <div class="flex items-center gap-2">
                                    <span class="font-semibold text-xs text-neutral-300">{{ comment.authorProfile?.username || translateText('anonymousUser', 'Anonimo') }}</span>
                                    
                                    <div v-if="comment.user === session.uid || drawerComments.currentSpot?.data?.user === session.uid || session.isAdmin" class="opacity-0 group-hover:opacity-100 flex items-center gap-1.5 transition-opacity">
                                        <button v-if="comment.user === session.uid" @click="comment.isEditing = true; comment.editText = comment.text" class="text-neutral-400 hover:text-blue-400 transition cursor-pointer" title="Modifica commento">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                        </button>
                                        <button @click="handleDeleteComment(drawerComments.currentSpot, cIdx)" class="text-neutral-400 hover:text-red-400 transition cursor-pointer" title="Elimina commento">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </div>
                                </div>
                                <span class="text-[10px] text-neutral-500">{{ formatTime(comment.timestamp) }}</span>
                            </div>

                            <p v-if="!comment.isEditing" class="text-neutral-200 text-xs leading-relaxed break-words">{{ comment.text }}</p>

                            <div v-else class="flex flex-col gap-1.5 mt-1">
                                <input type="text" v-model="comment.editText" class="w-full bg-neutral-800 border border-blue-500/50 rounded-lg px-2.5 py-1 text-xs outline-none text-white">
                                <div class="flex justify-end gap-1.5">
                                    <button @click="comment.isEditing = false" class="px-2 py-0.5 text-[10px] text-neutral-400 hover:bg-neutral-700 rounded cursor-pointer">{{ translateText('cancelBtn', 'Annulla') }}</button>
                                    <button @click="handleSaveCommentEdit(drawerComments.currentSpot, comment, cIdx)" class="px-2 py-0.5 text-[10px] bg-blue-600 text-white font-semibold rounded hover:bg-blue-700 cursor-pointer">{{ translateText('saveBtn', 'Salva') }}</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="p-3 border-t border-neutral-800 bg-neutral-950 flex items-center space-x-2">
                    <input 
                        type="text" 
                        v-model="drawerComments.newCommentText" 
                        @keyup.enter="submitDrawerComment"
                        :placeholder="translateText('addCommentPlaceholder', 'Aggiungi un commento...')" 
                        class="flex-grow bg-neutral-900 border border-neutral-700 rounded-full px-4 py-2.5 text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-blue-500 transition">
                    <button 
                        @click="submitDrawerComment"
                        :disabled="!drawerComments.newCommentText.trim() || drawerComments.isSubmitting"
                        class="bg-blue-600 hover:bg-blue-700 text-white rounded-full p-2.5 disabled:opacity-40 transition cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- MODALI LIKES, SEGNALAZIONI E MODIFICA SPOTINO -->
        <spot-likes-modal
            :modal="modals.likes"
            :t="translateText"
            :get-user-avatar-html="getUserAvatarHtml"
            @close="modals.likes.show = false"
        ></spot-likes-modal>

        <spot-report-modal
            :modal="reportModal"
            :t="translateText"
            @close="reportModal.show = false"
            @submit="submitReport"
        ></spot-report-modal>

        <spot-edit-modal
            :modal="editManager.editModal"
            :categories-list="editManager.categoriesList"
            @close="editManager.editModal.show = false"
            @save="editManager.saveEdit"
            @toggle-category="editManager.toggleCategory"
            @search-coauthors="editManager.searchCoAuthors"
            @add-coauthor="editManager.addCoAuthor"
            @remove-coauthor="editManager.removeCoAuthor"
            @remove-media="editManager.removeMedia"
            @files-selected="editManager.onFilesSelected"
        ></spot-edit-modal>

    </div>

    <!-- Script Base -->
    <script src="../core/load-firebase.js"></script>
    <script src="../core/load-shared-scripts.js"></script>
    <script src="../spot/feedAlgorithm.js"></script>
    <script type="module" src="spotini.js"></script>
    <script src="../core/load-nav-scripts.js"></script>
</body>
</html>
