                    <div class="flex space-x-3 pt-2">
                        <button type="button" @click="modals.ban.show = false" class="w-1/2 py-2.5 px-4 bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl hover:bg-gray-300 transition">
                            Chiudi
