                                                 (idx === selectedDayIndex 
                                                     ? (dayItem.isToday 
                                                         ? 'bg-gradient-to-t from-pink-500 to-purple-600 shadow-md ring-2 ring-purple-300' 
                                                         : 'bg-blue-600 shadow-sm ring-2 ring-blue-200')
